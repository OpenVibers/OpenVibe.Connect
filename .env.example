# OpenVibe Connect — every variable the service reads. Production: /etc/openvibe/connect.env (names only here).
NODE_ENV=development
PORT=5240
HOST=127.0.0.1
BASE_URL=http://localhost:5240
TRUST_PROXY=2

# PostgreSQL (ADR-035). Unset in development: an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=

# OpenVibe.Network sign-in (OAuth client `connect`).
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=connect
OV_OAUTH_CLIENT_SECRET=


# Outside sign-in apps (D11 owner settings): the admin panel's connect.signin_apps namespace wins;
# these are the fallback when no value was entered there.
CONNECT_TWITCH_CLIENT_ID=
CONNECT_TWITCH_CLIENT_SECRET=
CONNECT_GOOGLE_CLIENT_ID=
CONNECT_GOOGLE_CLIENT_SECRET=
CONNECT_LINEAR_CLIENT_ID=
CONNECT_LINEAR_CLIENT_SECRET=
CONNECT_NOTION_CLIENT_ID=
CONNECT_NOTION_CLIENT_SECRET=
CONNECT_META_CLIENT_ID=
CONNECT_META_CLIENT_SECRET=
CONNECT_TWILIO_CLIENT_ID=
CONNECT_TWILIO_CLIENT_SECRET=

# OpenVibe.Events: account export/deletion deliveries (comma-separated secrets for rotation).
CONNECT_EVENTS_URL=
CONNECT_EVENTS_SECRET=

# Shares. The session secret signs visitors' cookies on share hosts (required in production, 32+ characters).
CONNECT_SHARE_DOMAIN=openvibe.website
CONNECT_SESSION_SECRET=
CONNECT_SESSION_HOURS=12
CONNECT_SHARES_PER_PERSON=5
CONNECT_MAX_STREAMS=64
CONNECT_MAX_BODY_BYTES=104857600
CONNECT_REQUEST_TIMEOUT_MS=120000
CONNECT_REQUESTS_PER_MINUTE=1200
CONNECT_BYTES_PER_DAY=10737418240
CONNECT_PING_MS=25000

# Drill mode (restore drills): no Events subscriptions.
CONNECT_DRILL=
